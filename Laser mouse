javascript:(function(){const style=document.createElement('style');style.innerHTML='*{cursor:crosshair!important;}.laser-beam{position:fixed;z-index:999999;background:red;box-shadow:0 0 10px red;pointer-events:none;transition:all 0.15s ease-out;}';document.head.appendChild(style);document.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();const target=e.target;if(target===document.body||target===document.documentElement)return;const rect=target.getBoundingClientRect();const laser=document.createElement('div');laser.className='laser-beam';laser.style.left=e.clientX+'px';laser.style.top=e.clientY+'px';laser.style.width='2px';laser.style.height='2px';document.body.appendChild(laser);setTimeout(()=>{laser.style.left=rect.left+(rect.width/2)+'px';laser.style.top=rect.top+(rect.height/2)+'px';laser.style.width=rect.width+'px';laser.style.height=rect.height+'px';laser.style.opacity='0';},10);setTimeout(()=>{target.remove();laser.remove();},150);},true);})();
