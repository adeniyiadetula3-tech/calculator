javascript:(function(){if(window.canvasDrawerActive)return;window.canvasDrawerActive=true;const c=document.createElement("canvas");c.style.position="fixed";c.style.top="0";c.style.left="0";c.style.width="100vw";c.style.height="100vh";c.style.zIndex="999999";c.style.pointerEvents="auto";c.style.cursor="crosshair";const w=window.innerWidth;const h=window.innerHeight;c.width=w;c.height=h;document.body.appendChild(c);const ctx=c.getContext("2d");ctx.strokeStyle="red";ctx.lineWidth=4;ctx.lineCap="round";let d=false;c.addEventListener("mousedown",e=>{d=true;ctx.beginPath();ctx.moveTo(e.clientX,e.clientY)});c.addEventListener("mousemove",e=>{if(d){ctx.lineTo(e.clientX,e.clientY);ctx.stroke()}});c.addEventListener("mouseup",()=>d=false);c.addEventListener("mouseleave",()=>d=false);const btn=document.createElement("button");btn.innerText="Close Canvas";btn.style.position="fixed";btn.style.top="10px";btn.style.right="10px";btn.style.zIndex="1000000";btn.style.padding="8px 12px";btn.style.background="#ff4d4d";btn.style.color="#fff";btn.style.border="none";btn.style.borderRadius="4px";btn.style.cursor="pointer";document.body.appendChild(btn);btn.addEventListener("click",()=>{c.remove();btn.remove();window.canvasDrawerActive=false})})();
