javascript:(function(){var elements=document.querySelectorAll('p, h1, h2, h3, h4, h5, h6, span, a, li');for(var i=0;i<elements.length;i++){elements[i].style.background='linear-gradient(90deg, red, orange, yellow, green, blue, indigo, violet)';elements[i].style.webkitBackgroundClip='text';elements[i].style.webkitTextFillColor='transparent';elements[i].style.animation='rainbow 2s linear infinite';}var style=document.createElement('style');style.innerHTML='@keyframes rainbow {0% { filter: hue-rotate(0deg); } 100% { filter: hue-rotate(360deg); }}';document.head.appendChild(style);})();
