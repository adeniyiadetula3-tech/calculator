ullet();        if (gameOver || gameWon) {            if (e.key === 'r' || e.key === 'R') {                score = 0; lives = 3; level = 1;                alienRows = 3; alienSpeed = 1;                gameOver = false; gameWon = false;                setupInvaders();            }        }    });    function updateElements() {        for (var i = 0; i < bullets.length; i++) {            bullets[i].y -= bullets[i].dy;            if (bullets[i].y < 0) { bullets.splice(i, 1); i--; }        }        for (var i = 0; i < alienBullets.length; i++) {            alienBullets[i].y += alienBullets[i].dy;            if (alienBullets[i].y > c.height) { alienBullets.splice(i, 1); i--; }        }    }    function moveInvaders() {        var edge = false;        for (var i = 0; i < invaders.length; i++) {            if (!invaders[i].alive) continue;            invaders[i].x += alienSpeed;            if (invaders[i].x + invaders[i].width > c.width || invaders[i].x < 0) edge = true;            if (invaders[i].y + invaders[i].height >= player.y) gameOver = true;        }        if (edge) {            alienSpeed = -alienSpeed;            for (var i = 0; i < invaders.length; i++) {                invaders[i].y += 15;            }        }    }    function alienShoot() {        var living = invaders.filter(function(i) { return i.alive; });        if (living.length > 0 && Math.random() < 0.01 + (level * 0.005)) {            var shooter = living[Math.floor(Math.random() * living.length)];            alienBullets.push({ x: shooter.x + shooter.width / 2 - 2, y: shooter.y + shooter.height, width: 4, height: 10, dy: 4 });        }    }    function checkCollisions() {        for (var b = 0; b < bullets.length; b++) {            for (var i = 0; i < invaders.length; i++) {                if (invaders[i].alive &&                     bullets[b].x < invaders[i].x + invaders[i].width &&                    bullets[b].x + bullets[b].width > invaders[i].x &&                    bullets[b].y < invaders[i].y + invaders[i].height &&                    bullets[b].y + bullets[b].height > invaders[i].y) {                    invaders[i].alive = false;                    score += (invaders[i].row + 1) * 100;                    bullets.splice(b, 1);                    break;                }            }        }        for (var ab = 0; ab < alienBullets.length; ab++) {            if (alienBullets[ab].x < player.x + player.width &&                alienBullets[ab].x + alienBullets[ab].width > player.x &&                alienBullets[ab].y < player.y + player.height &&                alienBullets[ab].y + alienBullets[ab].height > player.y) {                alienBullets.splice(ab, 1);                lives--;                if (lives <= 0) gameOver = true;                break;            }        }        var allDead = true;        for (var i = 0; i < invaders.length; i++) {            if (invaders[i].alive) allDead = false;        }        if (allDead) {            level++;            alienRows = Math.min(6, alienRows + 1);            alienSpeed = alienSpeed > 0 ? 1 + (level * 0.2) : -1 - (level * 0.2);            setupInvaders();            player.x = 285;            bullets = []; alienBullets = [];        }    }    function draw() {        ctx.clearRect(0, 0, c.width, c.height);        if (gameOver) {            drawText(%27GAME OVER%27, 180, 250, %2740px Impact%27, %27red%27);            drawText(%27Press R to Restart%27, 200, 320, %2725px Arial%27, %27white%27);            drawText(%27Final Score: %27 + score, 210, 360, %2725px Arial%27, %27white%27);            return;        }        drawRect(player.x, player.y, player.width, player.height, %27green%27);        for (var i = 0; i < invaders.length; i++) {            if (invaders[i].alive) {                drawRect(invaders[i].x, invaders[i].y, invaders[i].width, invaders[i].height, %27red%27);            }        }        for (var i = 0; i < bullets.length; i++) {            drawRect(bullets[i].x, bullets[i].y, bullets[i].