javascript:(function(){const frog=document.createElement('div');frog.innerHTML='🐸';frog.style.position='fixed';frog.style.zIndex='999999';frog.style.fontSize='50px';frog.style.top='50%';frog.style.left='50%';frog.style.transform='translate(-50%, -50%)';frog.style.transition='all 0.3s ease';document.body.appendChild(frog);let hue=0;setInterval(()=>{frog.style.transform=`translate(${Math.random()*600-300}px, ${Math.random()*600-300}px) rotate(${Math.random()*360}deg) scale(${Math.random()+1})`;frog.style.filter=`hue-rotate(${hue}deg)`;hue+=30;if(hue>=360)hue=0;},800);})();
